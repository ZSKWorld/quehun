	// 	],
	// 	"description": "Log output to console"
	// }
	//#region 内置变量
	// 	TM_SELECTED_TEXT 当前选中的文本或者空字符串
	// 	TM_CURRENT_LINE 当前行的内容
	// 	TM_CURRENT_WORD 光标所在单词的内容或空字符串
	// 	TM_LINE_INDEX 从0开始的行号
	// 	TM_LINE_NUMBER 从1开始的行号
	// 	TM_FILENAME 当前文档的文件名
	// 	TM_FILENAME_BASE 当前文档的文件名（不含扩展名）
	// 	TM_DIRECTORY 当前文档的目录
	// 	TM_FILEPATH 当前文档的完整文件路径
	// 	RELATIVE_FILEPATH 当前文档相对于已打开的工作区或文件夹的相对文件路径
	// 	CLIPBOARD 剪贴板中的内容
	// 	WORKSPACE_NAME 已打开的工作区或文件夹的名称
	// 	WORKSPACE_FOLDER 已打开的工作区或文件夹的路径
	// 	CURSOR_INDEX 从0开始的游标编号
	// 	CURSOR_NUMBER 从1开始的游标编号
	// 	CURRENT_YEAR 当前年份
	// 	CURRENT_YEAR_SHORT 当前年份的最后两位数字
	// 	CURRENT_MONTH 当前月份，用两位数字表示 (example '02')
	// 	CURRENT_MONTH_NAME The 当前月份的全称 (example 'July')
	// 	CURRENT_MONTH_NAME_SHORT 当前月份的简称 (example 'Jul')
	// 	CURRENT_DATE 月份中的日期，用两位数字表示 (example '08')
	// 	CURRENT_DAY_NAME 星期几全称 (example 'Monday')
	// 	CURRENT_DAY_NAME_SHORT 星期几简称 (example 'Mon')
	// 	CURRENT_HOUR 当前时间-小时（以 24 小时制表示）
	// 	CURRENT_MINUTE 当前时间-分钟，用两位数字表示
	// 	CURRENT_SECOND 当前时间-秒，用两位数字表示
	// 	CURRENT_SECONDS_UNIX 自 Unix 纪元以来的秒数
	// 	CURRENT_TIMEZONE_OFFSET 当前UTC时区偏移量，为 +HH:MM 或 -HH:MM 格式 (example -07：00)
	// 	RANDOM 6位随机十进制数字
	// 	RANDOM_HEX 6位随机十六进制数字
	// 	UUID 版本4 UUID
	// 	BLOCK_COMMENT_START 注释开始，自适应语言 PHP /* or HTML <!--
	// 	BLOCK_COMMENT_END 注释结束，自适应语言 PHP */ or HTML -->
	// 	LINE_COMMENT 行注释，自适应语言 PHP //
	//#endregion
	"测试": {
		"prefix": "test",
		"body": [
			"//$TM_LINE_INDEX $TM_LINE_NUMBER",
			"//",
		],
	},
	"创建当前文件类": {
		"prefix": "class_create_for_current_file",
		"body": [
			"export class $TM_FILENAME_BASE {",
			"\t${0}",
			"}",
			"",
		],
	},
	"返回promise": {
		"prefix": "promise_return",
		"body": [
			"return new Promise<${1:void}>(resolve => {",
			"\t${0}",
			"});",
		],
	},
	"创建region块": {
		"prefix": "region",
		"body": [
			"//#region ${1:块说明文本}",
			"${0}",
			"//#endregion",
		],
	},
}