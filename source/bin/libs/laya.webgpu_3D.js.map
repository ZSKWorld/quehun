layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ------------------------------------------------------------------
// 结构体定义
// ------------------------------------------------------------------

struct Plane {
    vec3 normal; // 法向量 (a, b, c)
    float distance; // 距离 d
};

// otherData: x:need Cull y:need Range z: is shadow w:cullMask
struct oneCull {
    vec4 planes[6];
    vec4 cullPos;
    uvec4 otherData;
};

struct insCullData {
    vec4 min; // x,y,z 表示min, w 是距离最小值,小于w裁剪失败
    vec4 max; // x,y,z 表示max, w 是距离最大值,大于w裁剪失败
    uvec4 layer_CastShadow_other; // x renderLayer y castShadow z null w null
};

// ------------------------------------------------------------------
// Uniforms & Buffers
// ------------------------------------------------------------------
// uniform BatchCull_CullInfos
// {
//     // oneCull cullPlanes[6];
//     vec4 u_CullInfos[48];
//     uint u_computeMaxID;
// };

readonly buffer CullInfoDatas
{
    insCullData cullInfoDatas[];
};

buffer CullResourtBuffer
{
    uint cullResourt[];
};

// ------------------------------------------------------------------
// Helper Functions
// ------------------------------------------------------------------

bool isPatchRenderLayer(insCullData ins, oneCull cull)
{
    bool needCheckRenderLayer = cull.otherData.z < 1u;
    if (needCheckRenderLayer) {
        // 检测cameralayer
        return (cull.otherData.w & (1u << ins.layer_CastShadow_other.x)) > 0u;
    } else {
        // 检测shadowLayer
        return ins.layer_CastShadow_other.y > 0u;
    }
}

float distanceToPlane(vec3 point, vec4 plane)
{
    return dot(plane.xyz, point) + plane.w;
}

// 检查AABB是否与平面相交或在平面正面
bool isAABBInFrontOfPlane(insCullData aabb, vec4 plane)
{
    // 计算AABB的中心点
    vec3 center = (aabb.min.xyz + aabb.max.xyz) * 0.5;

    // 计算AABB的半尺寸
    vec3 halfSize = (aabb.max.xyz - aabb.min.xyz) * 0.5;

    // 计算AABB在平面法向量上的投影半径
    float projectionRadius = dot(abs(plane.xyz), halfSize);

    // 计算中心点到平面的距离
    float distanceToCenter = distanceToPlane(center, plane);

    // 如果距离大于负的投影半径,则AABB至少部分在平面正面
    return distanceToCenter > -projectionRadius;
}

// 计算点到AABB中心的距离平方
float distance_point_to_aabb(vec3 point, vec3 aabb_min, vec3 aabb_max)
{
    vec3 dif = point - (aabb_min + aabb_max) * 0.5;

    return dot(dif, dif);
}

float keepThreeDecimals(float value)
{
    return floor(value);
}

bool isRangeVisible(insCullData aabb, oneCull culldata)
{
    if (culldata.otherData.y < 1u) {
        // shadow 不判断range  不需要判断Range的时候不用判断Range LOD
        return true;
    }
    float dis = (distance_point_to_aabb(culldata.cullPos.xyz, aabb.min.xyz, aabb.max.xyz));
    return dis >= aabb.min.w && dis <= aabb.max.w;
}

bool isAABBVisible(insCullData aabb, oneCull cullData)
{
    // 遍历所有cull planes
    for (uint i = 0u; i < 6u; i++) {
        // 如果AABB完全在任何一个平面的背面,则被剔除
        vec4 cullPlane = cullData.planes[i];
        if (!isAABBInFrontOfPlane(aabb, cullPlane)) {
            return false;
        }
    }
    return true;
}

oneCull getOneCull(uint index)
{
    oneCull c;
    uint base = index * 8;
    c.planes[0] = u_CullInfos[base + 0];
    c.planes[1] = u_CullInfos[base + 1];
    c.planes[2] = u_CullInfos[base + 2];
    c.planes[3] = u_CullInfos[base + 3];
    c.planes[4] = u_CullInfos[base + 4];
    c.planes[5] = u_CullInfos[base + 5];

    c.cullPos = u_CullInfos[base + 6];

    c.otherData = floatBitsToUint(u_CullInfos[base + 7]);

    return c;
}

void main()
{
    uint instanceIndex = gl_GlobalInvocationID.x;
    if (instanceIndex >= u_computeMaxID) {
        return;
    }

    insCullData _inscullInfo = cullInfoDatas[instanceIndex];
    uint _bitValue = 0u;

    for (uint i = 0u; i < 6u; i++) {
        uint _bit = 1u << i;
        oneCull _cullInfo = getOneCull(i);

        if (_cullInfo.otherData.x < 1u) {
            continue;
        }
        if (!isPatchRenderLayer(_inscullInfo, _cullInfo)) {
            continue;
        }
        if (!isRangeVisible(_inscullInfo, _cullInfo)) {
            continue;
        }
        if (!isAABBVisible(_inscullInfo, _cullInfo)) {
            continue;
        }
        _bitValue = _bitValue + _bit;
    }

    cullResourt[instanceIndex] = _bitValue;
}